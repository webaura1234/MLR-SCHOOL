# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics (GA4 measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads (global site tag + conversions for Performance Max)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18209094786
# Conversion labels from Google Ads → Goals → Conversions (format: AW-18209094786/AbCdEfGh)
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ADMISSION=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=

# Google Sheets
NEXT_PUBLIC_SITE_INFO_SHEET_URL=your_published_sheet_csv_url

# Forms
NEXT_PUBLIC_ADMISSION_URL=your_google_apps_script_url

